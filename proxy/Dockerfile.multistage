FROM golang:1.27.3-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY client ./client
COPY dns ./dns
COPY encryption ./encryption
COPY flow ./flow
COPY formatter ./formatter
COPY monotime ./monotime
COPY management ./management
COPY proxy ./proxy
COPY route ./route
COPY shared ./shared
COPY sharedsock ./sharedsock
COPY trustedproxy ./trustedproxy
COPY upload-server ./upload-server
COPY util ./util
COPY version ./version
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o wardenclyffe-proxy ./proxy/cmd/proxy

RUN echo "wardenclyffe:x:1000:1000:wardenclyffe:/var/lib/wardenclyffe:/sbin/nologin" > /tmp/passwd && \
    echo "wardenclyffe:x:1000:wardenclyffe" > /tmp/group && \
    mkdir -p /tmp/var/lib/wardenclyffe && \
    mkdir -p /tmp/certs

FROM gcr.io/distroless/base:debug
COPY --from=builder /app/wardenclyffe-proxy /usr/bin/wardenclyffe-proxy
COPY --from=builder /tmp/passwd /etc/passwd
COPY --from=builder /tmp/group /etc/group
COPY --from=builder --chown=1000:1000 /tmp/var/lib/wardenclyffe /var/lib/wardenclyffe
COPY --from=builder --chown=1000:1000 --chmod=755 /tmp/certs /certs
USER wardenclyffe:wardenclyffe
ENV HOME=/var/lib/wardenclyffe
ENV NB_PROXY_ADDRESS=":8443"
EXPOSE 8443
ENTRYPOINT ["/usr/bin/wardenclyffe-proxy"]
