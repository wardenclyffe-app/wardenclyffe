# build & run locally with:
#   cd "$(git rev-parse --show-toplevel)"
#   CGO_ENABLED=0 go build -o wardenclyffe ./client
#   podman build -t localhost/wardenclyffe:latest -f client/Dockerfile --ignorefile .dockerignore-client .
#   podman run --rm -it --cap-add={BPF,NET_ADMIN,NET_RAW} localhost/wardenclyffe:latest

FROM alpine:3.24

RUN apk add --no-cache \
      bash \
      ca-certificates \
    && adduser -D -h /var/lib/wardenclyffe wardenclyffe

WORKDIR /var/lib/wardenclyffe
USER wardenclyffe:wardenclyffe

ENV \
    WARDENCLYFFE_BIN="/usr/local/bin/wardenclyffe" \
    NB_USE_NETSTACK_MODE="true" \
    NB_ENABLE_NETSTACK_LOCAL_FORWARDING="true" \
    NB_CONFIG="/var/lib/wardenclyffe/config.json" \
    NB_STATE_DIR="/var/lib/wardenclyffe" \
    NB_DAEMON_ADDR="unix:///var/lib/wardenclyffe/wardenclyffe.sock" \
    NB_LOG_FILE="console,/var/lib/wardenclyffe/client.log" \
    NB_DISABLE_DNS="true" \
    NB_ENABLE_CAPTURE="false" \
    NB_ENTRYPOINT_SERVICE_TIMEOUT="30"

ENTRYPOINT [ "/usr/local/bin/wardenclyffe-entrypoint.sh" ]
ARG TARGETPLATFORM
ARG WARDENCLYFFE_BINARY=$TARGETPLATFORM/wardenclyffe
COPY client/wardenclyffe-entrypoint.sh /usr/local/bin/wardenclyffe-entrypoint.sh
COPY "${WARDENCLYFFE_BINARY}"  /usr/local/bin/wardenclyffe
