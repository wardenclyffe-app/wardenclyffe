FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

ARG TARGETPLATFORM
ARG WARDENCLYFFE_BINARY=$TARGETPLATFORM/wardenclyffe
ARG VERSION=dev
ARG RELEASE=1

LABEL name="wardenclyffe-rootless" \
      maintainer="WardenClyffe <dev@wardenclyffe.app>" \
      vendor="WardenClyffe GmbH" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="WardenClyffe Rootless Client" \
      description="WardenClyffe connects devices through an encrypted overlay using userspace networking without a TUN device or network administration capabilities."

RUN microdnf install -y bash ca-certificates && microdnf clean all

COPY --chmod=0555 client/wardenclyffe-entrypoint.sh /usr/local/bin/wardenclyffe-entrypoint.sh
COPY --chmod=0555 ${WARDENCLYFFE_BINARY} /usr/local/bin/wardenclyffe
COPY licenses/ /licenses/
# Only application storage is group-writable for arbitrary non-root UIDs.
# Runtime-created credentials keep the client's restrictive file modes.
RUN mkdir -p /var/lib/wardenclyffe && \
    chown 1000:0 /var/lib/wardenclyffe && \
    chmod 0770 /var/lib/wardenclyffe && \
    chmod -R a+rX /licenses

WORKDIR /var/lib/wardenclyffe
USER 1000:0

ENV \
    HOME="/var/lib/wardenclyffe" \
    WARDENCLYFFE_BIN="/usr/local/bin/wardenclyffe" \
    NB_USE_NETSTACK_MODE="true" \
    NB_ENABLE_NETSTACK_LOCAL_FORWARDING="true" \
    NB_CONFIG="/var/lib/wardenclyffe/config.json" \
    NB_STATE_DIR="/var/lib/wardenclyffe" \
    NB_DAEMON_ADDR="unix:///var/lib/wardenclyffe/wardenclyffe.sock" \
    NB_LOG_FILE="console,/var/lib/wardenclyffe/client.log" \
    NB_DISABLE_DNS="true" \
    NB_ENABLE_CAPTURE="false" \
    NB_ENTRYPOINT_SERVICE_TIMEOUT="30"

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/wardenclyffe-entrypoint.sh"]
