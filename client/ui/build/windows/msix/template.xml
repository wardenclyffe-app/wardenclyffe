<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wardenclyffe-ui"
        Arguments=""
        InstallLocation="C:\Program Files\WardenClyffe\WardenClyffe">
    </Installer>
    <PackageInformation
        PackageName="WardenClyffe"
        PackageDisplayName="WardenClyffe"
        PublisherName="CN=WardenClyffe"
        PublisherDisplayName="WardenClyffe"
        Version="0.0.1.0"
        PackageDescription="WardenClyffe desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.wardenclyffe.client"
                Description="WardenClyffe desktop client"
                DisplayName="WardenClyffe"
                ExecutableName="wardenclyffe-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WardenClyffe</DisplayName>
            <PublisherDisplayName>WardenClyffe</PublisherDisplayName>
            <Description>WardenClyffe desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wardenclyffe-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
