## Most settings are being done automatically with the sourced variables from setup.env, but you can edit if you need some customization

# Management API

# Management API port
WARDENCLYFFE_MGMT_API_PORT=${WARDENCLYFFE_MGMT_API_PORT:-33073}
# Management API endpoint address, used by the Dashboard
WARDENCLYFFE_MGMT_API_ENDPOINT=https://$WARDENCLYFFE_DOMAIN:$WARDENCLYFFE_MGMT_API_PORT
# Management Certificate file path. These are generated by the Dashboard container
WARDENCLYFFE_LETSENCRYPT_DOMAIN=$WARDENCLYFFE_DOMAIN
WARDENCLYFFE_MGMT_API_CERT_FILE="/etc/letsencrypt/live/$WARDENCLYFFE_LETSENCRYPT_DOMAIN/fullchain.pem"
# Management Certificate key file path.
WARDENCLYFFE_MGMT_API_CERT_KEY_FILE="/etc/letsencrypt/live/$WARDENCLYFFE_LETSENCRYPT_DOMAIN/privkey.pem"
# By default Management single account mode is enabled and domain set to $WARDENCLYFFE_DOMAIN, you may want to set this to your user's email domain
WARDENCLYFFE_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN=$WARDENCLYFFE_DOMAIN
WARDENCLYFFE_MGMT_DNS_DOMAIN=${WARDENCLYFFE_MGMT_DNS_DOMAIN:-wardenclyffe.selfhosted}
WARDENCLYFFE_MGMT_IDP_SIGNKEY_REFRESH=${WARDENCLYFFE_MGMT_IDP_SIGNKEY_REFRESH:-false}
WARDENCLYFFE_MGMT_DISABLE_DEFAULT_POLICY=${WARDENCLYFFE_MGMT_DISABLE_DEFAULT_POLICY:-false}

# Signal
WARDENCLYFFE_SIGNAL_PROTOCOL="http"
WARDENCLYFFE_SIGNAL_PORT=${WARDENCLYFFE_SIGNAL_PORT:-10000}

# Relay
WARDENCLYFFE_RELAY_DOMAIN=${WARDENCLYFFE_RELAY_DOMAIN:-$WARDENCLYFFE_DOMAIN}
WARDENCLYFFE_RELAY_PORT=${WARDENCLYFFE_RELAY_PORT:-33080}
WARDENCLYFFE_RELAY_ENDPOINT=${WARDENCLYFFE_RELAY_ENDPOINT:-rel://$WARDENCLYFFE_RELAY_DOMAIN:$WARDENCLYFFE_RELAY_PORT}
# Relay auth secret
WARDENCLYFFE_RELAY_AUTH_SECRET=

# Turn
TURN_DOMAIN=${WARDENCLYFFE_TURN_DOMAIN:-$WARDENCLYFFE_DOMAIN}

WARDENCLYFFE_TURN_EXTERNAL_IP=${WARDENCLYFFE_TURN_EXTERNAL_IP}

# Turn credentials
# User
TURN_USER=self
# Password. If empty, the configure.sh will generate one with openssl
TURN_PASSWORD=
# Min port
TURN_MIN_PORT=${TURN_MIN_PORT:-49152}
# Max port
TURN_MAX_PORT=${TURN_MAX_PORT:-65535}

VOLUME_PREFIX="wardenclyffe-"
MGMT_VOLUMESUFFIX="mgmt"
SIGNAL_VOLUMESUFFIX="signal"
LETSENCRYPT_VOLUMESUFFIX="letsencrypt"

WARDENCLYFFE_AUTH_DEVICE_AUTH_PROVIDER="none"
WARDENCLYFFE_AUTH_DEVICE_AUTH_AUDIENCE=${WARDENCLYFFE_AUTH_DEVICE_AUTH_AUDIENCE:-$WARDENCLYFFE_AUTH_AUDIENCE}
WARDENCLYFFE_AUTH_DEVICE_AUTH_SCOPE=${WARDENCLYFFE_AUTH_DEVICE_AUTH_SCOPE:-openid}
WARDENCLYFFE_AUTH_DEVICE_AUTH_USE_ID_TOKEN=${WARDENCLYFFE_AUTH_DEVICE_AUTH_USE_ID_TOKEN:-false}


WARDENCLYFFE_DISABLE_ANONYMOUS_METRICS=${WARDENCLYFFE_DISABLE_ANONYMOUS_METRICS:-false}
WARDENCLYFFE_TOKEN_SOURCE=${WARDENCLYFFE_TOKEN_SOURCE:-accessToken}

# PKCE authorization flow
WARDENCLYFFE_AUTH_PKCE_REDIRECT_URL_PORTS=${WARDENCLYFFE_AUTH_PKCE_REDIRECT_URL_PORTS:-"53000"}
WARDENCLYFFE_AUTH_PKCE_USE_ID_TOKEN=${WARDENCLYFFE_AUTH_PKCE_USE_ID_TOKEN:-false}
WARDENCLYFFE_AUTH_PKCE_DISABLE_PROMPT_LOGIN=${WARDENCLYFFE_AUTH_PKCE_DISABLE_PROMPT_LOGIN:-false}
WARDENCLYFFE_AUTH_PKCE_LOGIN_FLAG=${WARDENCLYFFE_AUTH_PKCE_LOGIN_FLAG:-0}
WARDENCLYFFE_AUTH_PKCE_AUDIENCE=$WARDENCLYFFE_AUTH_AUDIENCE

# Dashboard

# The default setting is to transmit the audience to the IDP during authorization. However,
# if your IDP does not have this capability, you can turn this off by setting it to false.
WARDENCLYFFE_DASH_AUTH_USE_AUDIENCE=${WARDENCLYFFE_DASH_AUTH_USE_AUDIENCE:-true}
WARDENCLYFFE_DASH_AUTH_AUDIENCE=$WARDENCLYFFE_AUTH_AUDIENCE

# Store config
WARDENCLYFFE_STORE_CONFIG_ENGINE=${WARDENCLYFFE_STORE_CONFIG_ENGINE:-"sqlite"}

# Image tags
WARDENCLYFFE_DASHBOARD_TAG=${WARDENCLYFFE_DASHBOARD_TAG:-"latest"}
WARDENCLYFFE_SIGNAL_TAG=${WARDENCLYFFE_SIGNAL_TAG:-"latest"}
WARDENCLYFFE_MANAGEMENT_TAG=${WARDENCLYFFE_MANAGEMENT_TAG:-"latest"}
COTURN_TAG=${COTURN_TAG:-"latest"}
WARDENCLYFFE_RELAY_TAG=${WARDENCLYFFE_RELAY_TAG:-"latest"}

# exports
export WARDENCLYFFE_DOMAIN
export WARDENCLYFFE_TURN_DOMAIN
export WARDENCLYFFE_AUTH_CLIENT_ID
export WARDENCLYFFE_AUTH_CLIENT_SECRET
export WARDENCLYFFE_AUTH_AUDIENCE
export WARDENCLYFFE_AUTH_AUTHORITY
export WARDENCLYFFE_USE_AUTH0
export WARDENCLYFFE_AUTH_SUPPORTED_SCOPES
export WARDENCLYFFE_AUTH_JWT_CERTS
export WARDENCLYFFE_LETSENCRYPT_EMAIL
export WARDENCLYFFE_MGMT_API_PORT
export WARDENCLYFFE_MGMT_API_ENDPOINT
export WARDENCLYFFE_LETSENCRYPT_DOMAIN
export WARDENCLYFFE_MGMT_API_CERT_FILE
export WARDENCLYFFE_MGMT_API_CERT_KEY_FILE
export WARDENCLYFFE_AUTH_DEVICE_AUTH_PROVIDER
export WARDENCLYFFE_AUTH_DEVICE_AUTH_CLIENT_ID
export WARDENCLYFFE_AUTH_OIDC_CONFIGURATION_ENDPOINT
export WARDENCLYFFE_AUTH_REDIRECT_URI
export WARDENCLYFFE_AUTH_SILENT_REDIRECT_URI
export TURN_DOMAIN
export TURN_USER
export TURN_PASSWORD
export TURN_MIN_PORT
export TURN_MAX_PORT
export VOLUME_PREFIX
export MGMT_VOLUMESUFFIX
export SIGNAL_VOLUMESUFFIX
export LETSENCRYPT_VOLUMESUFFIX
export WARDENCLYFFE_DISABLE_ANONYMOUS_METRICS
export WARDENCLYFFE_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN
export WARDENCLYFFE_MGMT_DNS_DOMAIN
export WARDENCLYFFE_MGMT_IDP_SIGNKEY_REFRESH
export WARDENCLYFFE_SIGNAL_PROTOCOL
export WARDENCLYFFE_SIGNAL_PORT
export WARDENCLYFFE_AUTH_USER_ID_CLAIM
export WARDENCLYFFE_AUTH_DEVICE_AUTH_AUDIENCE
export WARDENCLYFFE_TOKEN_SOURCE
export WARDENCLYFFE_AUTH_DEVICE_AUTH_SCOPE
export WARDENCLYFFE_AUTH_DEVICE_AUTH_USE_ID_TOKEN
export WARDENCLYFFE_AUTH_PKCE_AUTHORIZATION_ENDPOINT
export WARDENCLYFFE_AUTH_PKCE_USE_ID_TOKEN
export WARDENCLYFFE_AUTH_PKCE_DISABLE_PROMPT_LOGIN
export WARDENCLYFFE_AUTH_PKCE_LOGIN_FLAG
export WARDENCLYFFE_AUTH_PKCE_AUDIENCE
