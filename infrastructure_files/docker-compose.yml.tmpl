x-default: &default
  restart: 'unless-stopped'
  logging:
    driver: 'json-file'
    options:
      max-size: '500m'
      max-file: '2'

services:
  # UI dashboard
  dashboard:
    <<: *default
    image: shippin/wardenclyffe/dashboard:$WARDENCLYFFE_DASHBOARD_TAG
    ports:
      - 80:80
      - 443:443
    environment:
      # Endpoints
      - WARDENCLYFFE_MGMT_API_ENDPOINT=$WARDENCLYFFE_MGMT_API_ENDPOINT
      - WARDENCLYFFE_MGMT_GRPC_API_ENDPOINT=$WARDENCLYFFE_MGMT_API_ENDPOINT
      # OIDC
      - AUTH_AUDIENCE=$WARDENCLYFFE_DASH_AUTH_AUDIENCE
      - AUTH_CLIENT_ID=$WARDENCLYFFE_AUTH_CLIENT_ID
      - AUTH_CLIENT_SECRET=$WARDENCLYFFE_AUTH_CLIENT_SECRET
      - AUTH_AUTHORITY=$WARDENCLYFFE_AUTH_AUTHORITY
      - USE_AUTH0=$WARDENCLYFFE_USE_AUTH0
      - AUTH_SUPPORTED_SCOPES=$WARDENCLYFFE_AUTH_SUPPORTED_SCOPES
      - AUTH_REDIRECT_URI=$WARDENCLYFFE_AUTH_REDIRECT_URI
      - AUTH_SILENT_REDIRECT_URI=$WARDENCLYFFE_AUTH_SILENT_REDIRECT_URI
      - WARDENCLYFFE_TOKEN_SOURCE=$WARDENCLYFFE_TOKEN_SOURCE
      # SSL
      - NGINX_SSL_PORT=443
      # Letsencrypt
      - LETSENCRYPT_DOMAIN=$WARDENCLYFFE_LETSENCRYPT_DOMAIN
      - LETSENCRYPT_EMAIL=$WARDENCLYFFE_LETSENCRYPT_EMAIL
    volumes:
      - $LETSENCRYPT_VOLUMENAME:/etc/letsencrypt/

  # Signal
  signal:
    <<: *default
    image: shippin/wardenclyffe/signal:$WARDENCLYFFE_SIGNAL_TAG
    depends_on:
          - dashboard
    volumes:
      - $SIGNAL_VOLUMENAME:/var/lib/wardenclyffe
      - $LETSENCRYPT_VOLUMENAME:/etc/letsencrypt:ro
    ports:
      - $WARDENCLYFFE_SIGNAL_PORT:80
  #      # port and command for Let's Encrypt validation
  #      - 443:443
  #    command: ["--letsencrypt-domain", "$WARDENCLYFFE_LETSENCRYPT_DOMAIN", "--log-file", "console"]
    command: [
      "--cert-file", "$WARDENCLYFFE_MGMT_API_CERT_FILE",
      "--cert-key", "$WARDENCLYFFE_MGMT_API_CERT_KEY_FILE",
      "--log-file", "console",
      "--port", "80"
    ]

  # Relay
  relay:
    <<: *default
    image: shippin/wardenclyffe/relay:$WARDENCLYFFE_RELAY_TAG
    environment:
    - NB_LOG_LEVEL=info
    - NB_LISTEN_ADDRESS=:$WARDENCLYFFE_RELAY_PORT
    - NB_EXPOSED_ADDRESS=$WARDENCLYFFE_RELAY_ENDPOINT
    # todo: change to a secure secret
    - NB_AUTH_SECRET=$WARDENCLYFFE_RELAY_AUTH_SECRET
    ports:
      - $WARDENCLYFFE_RELAY_PORT:$WARDENCLYFFE_RELAY_PORT

  # Management
  management:
    <<: *default
    image: shippin/wardenclyffe/management:$WARDENCLYFFE_MANAGEMENT_TAG
    depends_on:
      - dashboard
    volumes:
      - $MGMT_VOLUMENAME:/var/lib/wardenclyffe
      - $LETSENCRYPT_VOLUMENAME:/etc/letsencrypt:ro
      - ./management.json:/etc/wardenclyffe/management.json
    ports:
      - $WARDENCLYFFE_MGMT_API_PORT:443 #API port
  #    # command for Let's Encrypt validation without dashboard container
  #    command: ["--letsencrypt-domain", "$WARDENCLYFFE_LETSENCRYPT_DOMAIN", "--log-file", "console"]
    command: [
      "--port", "443",
      "--log-file", "console",
      "--log-level", "info",
      "--disable-anonymous-metrics=$WARDENCLYFFE_DISABLE_ANONYMOUS_METRICS",
      "--single-account-mode-domain=$WARDENCLYFFE_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN",
      "--dns-domain=$WARDENCLYFFE_MGMT_DNS_DOMAIN"
      ]
    environment:
      - WARDENCLYFFE_STORE_ENGINE_POSTGRES_DSN=$WARDENCLYFFE_STORE_ENGINE_POSTGRES_DSN
      - WARDENCLYFFE_STORE_ENGINE_MYSQL_DSN=$WARDENCLYFFE_STORE_ENGINE_MYSQL_DSN
      
  # Coturn
  coturn:
    <<: *default
    image: coturn/coturn:$COTURN_TAG
    #domainname: $TURN_DOMAIN # only needed when TLS is enabled
    volumes:
      - ./turnserver.conf:/etc/turnserver.conf:ro
    #      - ./privkey.pem:/etc/coturn/private/privkey.pem:ro
    #      - ./cert.pem:/etc/coturn/certs/cert.pem:ro
    network_mode: host
    command:
      - -c /etc/turnserver.conf

volumes:
  $MGMT_VOLUMENAME:
  $SIGNAL_VOLUMENAME:
  $LETSENCRYPT_VOLUMENAME:
